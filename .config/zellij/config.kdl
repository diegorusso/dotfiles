        ribbon_selected { base "#322115"; background "#ffdfba"; emphasis_0 "#322115"; emphasis_1 "#e69875"; emphasis_2 "#d699b6"; emphasis_3 "#7fbbb3"; }
        text_unselected { base "#ffdfba"; background "#322115"; emphasis_0 "#e69875"; emphasis_1 "#83c092"; emphasis_2 "#ffaf5f"; emphasis_3 "#d699b6"; }
        text_selected { base "#ffdfba"; background "#52351d"; emphasis_0 "#e69875"; emphasis_1 "#83c092"; emphasis_2 "#ffaf5f"; emphasis_3 "#d699b6"; }
        frame_selected { base "#ffaf5f"; background 0; emphasis_0 "#e69875"; emphasis_1 "#83c092"; emphasis_2 "#d699b6"; emphasis_3 0; }
        frame_highlight { base "#e69875"; background 0; emphasis_0 "#d699b6"; emphasis_1 0; emphasis_2 "#e69875"; emphasis_3 "#e69875"; }
        exit_code_success { base "#ffaf5f"; background 0; emphasis_0 "#83c092"; emphasis_1 "#322115"; emphasis_2 "#d699b6"; emphasis_3 "#7fbbb3"; }
        exit_code_error { base "#e67e80"; background 0; emphasis_0 "#dbbc7f"; emphasis_1 0; emphasis_2 0; emphasis_3 0; }
