        table_cell_selected { base "#ffdfba"; background "#52351d"; emphasis_0 "#e69875"; emphasis_1 "#83c092"; emphasis_2 "#ffaf5f"; emphasis_3 "#d699b6"; }
        list_unselected { base "#ffdfba"; background "#322115"; emphasis_0 "#e69875"; emphasis_1 "#83c092"; emphasis_2 "#ffaf5f"; emphasis_3 "#d699b6"; }
        list_selected { base "#ffdfba"; background "#52351d"; emphasis_0 "#e69875"; emphasis_1 "#83c092"; emphasis_2 "#ffaf5f"; emphasis_3 "#d699b6"; }
        multiplayer_user_colors { player_1 "#d699b6"; player_2 "#7fbbb3"; player_3 0; player_4 "#dbbc7f"; player_5 "#83c092"; player_6 0; player_7 "#e67e80"; player_8 0; player_9 0; player_10 0; }
