// Device accents are selected by zj; direct zellij launches default to green.
theme "dotfiles-green"
default_layout "repo"
pane_frame_style "full"

// Panes must use a terminal definition available on remote hosts.
env {
    TERM "xterm-256color"
}

// Inherit Zellij's defaults; add workspace shortcuts to Ctrl+B mode.
keybinds {
    tmux {
        bind "?" {
            Run "bash" "-c" "{ printf '%s\\n' 'Custom shortcuts: Ctrl+B R = repo picker; Ctrl+B M = monitor; Ctrl+B ? = help' ''; zellij setup --dump-config; } | less" {
                name "Shortcuts (q to close, / to search)"
                floating true
                close_on_exit true
            }
            SwitchToMode "Normal"
        }
        bind "R" {
            Run "bash" "-c" "exec bash \"$HOME/.config/zellij/pick-repo.sh\"" {
                floating true
                close_on_exit true
            }
            SwitchToMode "Normal"
        }
        bind "M" {
            Run "bash" "-c" "exec bash \"$HOME/.config/zellij/open-monitor.sh\"" {
                name "Open monitor"
                floating true
                close_on_exit true
            }
            SwitchToMode "Normal"
        }
    }
}

themes {
    // Explicit UI styles keep shortcut letters independent of red error messages.
    dotfiles-green {
        ribbon_unselected { base "#102b1b"; background "#87d787"; emphasis_0 "#102b1b"; emphasis_1 "#b7efc5"; emphasis_2 "#7fbbb3"; emphasis_3 "#d699b6"; }
        ribbon_selected { base "#102b1b"; background "#b7efc5"; emphasis_0 "#102b1b"; emphasis_1 "#e69875"; emphasis_2 "#d699b6"; emphasis_3 "#7fbbb3"; }
        text_unselected { base "#b7efc5"; background "#102b1b"; emphasis_0 "#e69875"; emphasis_1 "#83c092"; emphasis_2 "#87d787"; emphasis_3 "#d699b6"; }
        text_selected { base "#b7efc5"; background "#21482e"; emphasis_0 "#e69875"; emphasis_1 "#83c092"; emphasis_2 "#87d787"; emphasis_3 "#d699b6"; }
        frame_selected { base "#87d787"; background 0; emphasis_0 "#e69875"; emphasis_1 "#83c092"; emphasis_2 "#d699b6"; emphasis_3 0; }
        frame_highlight { base "#e69875"; background 0; emphasis_0 "#d699b6"; emphasis_1 0; emphasis_2 "#e69875"; emphasis_3 "#e69875"; }
        exit_code_success { base "#87d787"; background 0; emphasis_0 "#83c092"; emphasis_1 "#102b1b"; emphasis_2 "#d699b6"; emphasis_3 "#7fbbb3"; }
        exit_code_error { base "#e67e80"; background 0; emphasis_0 "#dbbc7f"; emphasis_1 0; emphasis_2 0; emphasis_3 0; }
        table_title { base "#87d787"; background 0; emphasis_0 "#e69875"; emphasis_1 "#83c092"; emphasis_2 "#87d787"; emphasis_3 "#d699b6"; }
        table_cell_unselected { base "#b7efc5"; background "#102b1b"; emphasis_0 "#e69875"; emphasis_1 "#83c092"; emphasis_2 "#87d787"; emphasis_3 "#d699b6"; }
        table_cell_selected { base "#b7efc5"; background "#21482e"; emphasis_0 "#e69875"; emphasis_1 "#83c092"; emphasis_2 "#87d787"; emphasis_3 "#d699b6"; }
        list_unselected { base "#b7efc5"; background "#102b1b"; emphasis_0 "#e69875"; emphasis_1 "#83c092"; emphasis_2 "#87d787"; emphasis_3 "#d699b6"; }
        list_selected { base "#b7efc5"; background "#21482e"; emphasis_0 "#e69875"; emphasis_1 "#83c092"; emphasis_2 "#87d787"; emphasis_3 "#d699b6"; }
        multiplayer_user_colors { player_1 "#d699b6"; player_2 "#7fbbb3"; player_3 0; player_4 "#dbbc7f"; player_5 "#83c092"; player_6 0; player_7 "#e67e80"; player_8 0; player_9 0; player_10 0; }
